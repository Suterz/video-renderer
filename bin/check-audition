#!/usr/bin/env python3
"""Unprompted local transcription and waveform diagnostics for the blind set."""
import concurrent.futures
import json
import math
import os
import re
import subprocess
import sys
import wave
from array import array
from difflib import SequenceMatcher
from pathlib import Path

root = Path(sys.argv[1])
blind = root / "blind"
key = json.loads((blind / "Answer key.json").read_text())
worker = Path(__file__).resolve().parents[1] / "src/video_renderer/speech_worker.py"
python = Path.home() / "venvs/v2-asr/bin/python"


def check(path):
    asr = subprocess.run([str(python), str(worker), "asr", str(root), str(path)],
                         input='{"text":""}', capture_output=True, text=True, check=True, timeout=120,
                         env={**os.environ, "HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1"})
    words = json.loads(asr.stdout.splitlines()[-1])
    transcript = "".join(w["word"] for w in words).strip()
    expected = key[path.stem[0]]["passages"][int(path.stem[-1]) - 1]
    norm = lambda t: re.findall(r"[\w]+", t.casefold())
    matcher = SequenceMatcher(None, norm(expected), norm(transcript), autojunk=False)
    with wave.open(str(path), "rb") as f:
        rate = f.getframerate()
        pcm = array("h", f.readframes(f.getnframes()))
    silent, longest = 0, 0
    for start in range(0, len(pcm), rate // 20):
        chunk = pcm[start:start+rate//20]
        if math.sqrt(sum(x*x for x in chunk) / len(chunk)) < 32768 * .01:
            silent += len(chunk)
            longest = max(silent, longest)
        else:
            silent = 0
    return path.name, {"expected": expected, "transcript": transcript, "asr_token_agreement_raw": matcher.ratio(),
                        "disagreements": [(op, norm(expected)[a:b], norm(transcript)[c:d])
                                          for op, a, b, c, d in matcher.get_opcodes() if op != "equal"],
                        "duration_seconds": len(pcm) / rate, "longest_quiet_seconds": longest / rate,
                        "pcm_clip_samples": sum(abs(i) >= 32767 for i in pcm)}


with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
    evidence = dict(pool.map(check, sorted((blind / "Listen first").glob("*.wav"))))
(blind / "Transcription and waveform checks.json").write_text(json.dumps(evidence, indent=2))
