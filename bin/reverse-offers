#!/usr/bin/env python3
"""Swap the two teaching groups while preserving offer identities and cutouts."""
import json
import sys
from pathlib import Path

import httpx

old = Path.home() / "Videos/video-renderer/jobs" / sys.argv[1]
req = json.loads((old / "request.json").read_text())
manifest = json.loads((old / "manifest.json").read_text())
sid = manifest["session_id"]
first, last = req["beats"][0]["panel"], req["beats"][-1]["panel"]
def swapped(y):
    if .20 < y < .50:
        return y + .33
    if .50 < y < .81:
        return y - .33
    return y

layers = first["layout"]["layers"]
for layer in layers:
    layer["center"][1] = swapped(layer["center"][1])
for overlay in last["overlays"]:
    overlay["at"][1] = swapped(overlay["at"][1])
check = {"question": "Which offer costs less per orange? Answer only A or B.", "expected": "B"}
order = {"question": "Which offer is in the top row? Answer only A or B.", "expected": "B"}
body = {**first, "key": "reversed", "scene_id": "comparison-reversed", "overlays": last["overlays"],
        "composed_checks": [check, order]}
r = httpx.post(f"http://127.0.0.1:8788/v2/sessions/{sid}/panels", json=body)
r.raise_for_status()
print(json.dumps(r.json()))
