#!/usr/bin/env python3
"""Independent raster test of the accepted offer art; not a runtime rule."""
import sys
from pathlib import Path

from PIL import Image

p = Path(sys.argv[1])
im = Image.open(p).convert("RGB").resize((360, 640))
pix = im.load()
candidates = {
    (x, y) for y in range(640) for x in range(360)
    if (lambda r, g, b: r >= 210 and 60 <= g <= 203 and b < 105 and r - g >= 40)(*pix[x, y])
}
centroids = []
while candidates:
    point = candidates.pop()
    stack, island = [point], [point]
    while stack:
        x, y = stack.pop()
        for adjacent in ((x+1,y), (x-1,y), (x,y+1), (x,y-1)):
            if adjacent in candidates:
                stack.append(adjacent)
                island.append(adjacent)
                candidates.remove(adjacent)
    if len(island) >= 100:
        centroids.append((sum(x for x, _ in island)/len(island), sum(y for _, y in island)/len(island)))
counts = [sum(y < 300 for _, y in centroids), sum(y >= 300 for _, y in centroids)]
assert counts == [3, 5], (counts, centroids)
assert 600 // 3 == 200 and 800 // 5 == 160 and 200 - 160 == 40
print("Phone-size independent orange components:", counts, "integer cent difference:", 40)
