#!/usr/bin/env python3
"""Package a blind listening set only after all ten source clips exist."""
import hashlib
import json
import random
import re
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
out = root / "blind"
blind = out / "Listen first"
blind.mkdir(parents=True, exist_ok=True)
ff = str(Path.home() / "ai/tools/media/bin/ffmpeg")
voices = ["ryan", "heart", "chatter", "laura", "jasper"]
random.Random(51963).shuffle(voices)
key, checks = {}, {}


def invoke(*args):
    return subprocess.run([ff, "-hide_banner", "-nostdin", *args], capture_output=True,
                          check=True, text=True, timeout=120).stderr


def loudness(source):
    result = invoke("-i", str(source), "-af", "loudnorm=I=-18:TP=-1.5:LRA=11:print_format=json",
                    "-f", "null", "-")
    return json.loads(re.findall(r'\{\s*"input_i".*?\}', result, re.S)[-1])


for letter, voice in zip("ABCDE", voices):
    key[letter] = json.loads((root / "raw" / f"{voice}.json").read_text())
    for passage in (1, 2):
        raw = root / "raw" / f"{voice}-{passage}.wav"
        out_wav = blind / f"{letter}{passage}.wav"
        m = loudness(raw)
        # Linear gain preserves the voice's dynamics; if peak-limited, apply
        # two-pass loudnorm rather than silently delivering unequal loudness.
        gain = -18 - float(m["input_i"])
        if float(m["input_tp"]) + gain <= -1.5:
            filter_ = f"volume={gain}dB"
        else:
            filter_ = ("loudnorm=I=-18:TP=-1.5:LRA=11:linear=true:"
                       f"measured_I={m['input_i']}:measured_TP={m['input_tp']}:"
                       f"measured_LRA={m['input_lra']}:measured_thresh={m['input_thresh']}:offset={m['target_offset']}")
        invoke("-y", "-i", str(raw), "-map_metadata", "-1", "-af", filter_, "-ac", "1",
               "-ar", "48000", "-c:a", "pcm_s16le", str(out_wav))
        verified = loudness(out_wav)
        if abs(float(verified["input_i"]) + 18) > 1 or float(verified["input_tp"]) > -1:
            raise ValueError(f"{out_wav.name}: post-normalization level out of bounds: {verified}")
        checks[out_wav.name] = {"lufs": float(verified["input_i"]), "true_peak_dbtp": float(verified["input_tp"]),
                                 "sha256": hashlib.sha256(out_wav.read_bytes()).hexdigest()}
(out / "Answer key.json").write_text(json.dumps(key, indent=2))
(out / "Audio measurements.json").write_text(json.dumps(checks, indent=2))
(out / "notes.md").write_text(
    "# Five narrator blind audition\n\nOpen `Listen first/`: letters A–E stay fixed across passages 1 and 2. "
    "Compare warmth, question inflection, pause before the contrast, intelligibility and the technical terms. "
    "Pick one or two favorites before opening the answer key. Automated loudness and peak measurements are supplied; "
    "naturalness and perceived enthusiasm await your listening review.\n")
print(f"packaged {len(checks)} clips")
